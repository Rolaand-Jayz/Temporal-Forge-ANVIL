+bool GpuImageUploader::publishRawPresentation() {
+  if (frameUploadBatch_ || deferredFrameUploads_ ||
+      rawPresentation_.image == VK_NULL_HANDLE ||
+      publishedRawPresentation_.image == VK_NULL_HANDLE || !beginUploadCmd())
